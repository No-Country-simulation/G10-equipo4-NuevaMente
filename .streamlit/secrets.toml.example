# Plantilla de secretos para Streamlit Community Cloud.
# Copia este contenido en el panel "Secrets" de la app (o en .streamlit/secrets.toml en local,
# que esta en .gitignore). No subas claves reales al repositorio.

# Proveedor de IA. Para un sitio publicado se recomienda "gemini": Ollama por ngrok
# solo funciona mientras el tunel este encendido (ver NGROK.md).
LLM_PROVEEDOR = "gemini"
GEMINI_API_KEY = "tu_api_key_aqui"
GEMINI_MODEL = "gemini-flash-latest"
GEMINI_TIMEOUT_SECONDS = "45"

# Solo si usas Ollama como principal (LLM_PROVEEDOR = "ollama")
# OLLAMA_BASE_URL = "https://tu-dominio.ngrok-free.dev"
# OLLAMA_MODEL = "qwen2.5:7b"
# OLLAMA_TIMEOUT_SECONDS = "60"

# Almacenamiento (opcional: sin esto la app genera igual y muestra "No se guardo en la nube").
# Usa la clave service_role y un bucket privado.
# SUPABASE_URL = "https://tu-proyecto.supabase.co"
# SUPABASE_KEY = "tu_clave"
# SUPABASE_BUCKET = "documentos"
