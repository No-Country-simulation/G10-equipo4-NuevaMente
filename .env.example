# Proveedor de IA: "ollama" (por defecto) o "gemini"
LLM_PROVEEDOR=ollama
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-flash-latest

# Ollama principal mediante un tunel ngrok activo hacia el puerto 11434.
# Sustituye el ejemplo por tu URL HTTPS real, sin /api ni /api/chat.
# Si Ollama/ngrok falla, se usa Gemini cuando hay GEMINI_API_KEY.
OLLAMA_BASE_URL=https://tu-dominio.ngrok-free.dev
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60
GEMINI_TIMEOUT_SECONDS=45

# Almacenamiento de documentos y resultados (opcional: sin esto la app genera igual
# y el resultado muestra "No se guardo en la nube")
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave
SUPABASE_BUCKET=documentos
